{
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2023"],
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,

    // Node runs these files directly by stripping the types (no build step),
    // which only works if nothing needs emitting: no enums, no namespaces, no
    // parameter properties. `erasableSyntaxOnly` makes tsc enforce that.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": false,
    "noEmit": true,

    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts", "db/**/*.ts", "test/**/*.ts", "drizzle.config.ts"]
}
