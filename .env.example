# Copy to .env for local development (`cp .env.example .env`).
# Matches the credentials in docker-compose.yml.
DATABASE_URL=postgresql://debt:debt@localhost:5433/debt

# HTTP server (optional overrides)
PORT=3001
HOST=0.0.0.0

# FX. Курси тягнуться з живого агрегатора; RATE_SOURCE=hardcoded вмикає
# офлайн-фолбек із фіксованими числами (демо без мережі, тести).
RATE_SOURCE=external
RATE_API_URL=https://rate-agg-server-production.up.railway.app/share/8?rateType=SOURCE_RATE

# Сесії. За замовчуванням не спливають за часом: розлогінює лише «Вийти»,
# ротація або відкликання. Додатне число повертає строк у днях.
SESSION_TTL_DAYS=0

# Пароль адміністратора, якого створює сід (db/seeds/seed.ts).
SEED_ADMIN_PASSWORD=Admin123
