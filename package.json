{
  "name": "server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.ts",
    "start": "node src/index.ts",
    "seed": "node db/seeds/seed.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:reset": "node db/migrate.ts && node db/seeds/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/jwt": "^10.2.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/static": "^10.1.2",
    "@node-rs/argon2": "^2.0.2",
    "dotenv": "^17.0.0",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.7.0",
    "fastify-plugin": "^6.0.0",
    "pg": "^8.13.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.0",
    "typescript": "^7.0.2"
  }
}
